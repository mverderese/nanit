# Required. One or more comma-separated secrets; the first encrypts, all decrypt (rotation).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_SECRET=

# Public https URL of this server. On Vercel it falls back to the deployment URL.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Default IANA time zone for night windows (users can override on the sign-in page / per call)
DEFAULT_TIMEZONE=America/New_York

# Allow http://localhost / 127.0.0.1 OAuth redirects (needed for Claude Code). Set false to disable.
ALLOW_LOOPBACK_REDIRECTS=true
